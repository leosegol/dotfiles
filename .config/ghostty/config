cursor-style = block
cursor-style-blink = false
font-family = "Fira Code"
font-size = 15
fullscreen = true
mouse-hide-while-typing = true
quit-after-last-window-closed = true
theme = Rose Pine
shell-integration-features = no-cursor
macos-option-as-alt = left

# Make shift+enter send ESC + CR, which is exactly what option+enter sends and
# what TUIs read as "insert a newline". Going through the keyboard protocol
# instead would be cleaner, but tmux 3.6 only honours an app's modifyOtherKeys
# request and ignores the kitty one, so a protocol-based shift+enter silently
# collapses to a plain enter inside tmux. These bytes need no protocol at all.
keybind = shift+enter=text:\x1b\r

# Window navigation with cmd+left/right. Ghostty defaults these to \x01 / \x05
# (readline start/end of line), so tmux never sees them; emit the alt+arrow
# sequences instead, which tmux reads as M-Left/M-Right and binds in
# ~/.tmux.conf.local. tmux has no notion of a super modifier, so borrowing
# alt's encoding is the only way to get cmd through to it.
# Replaces cmd+left/right as home/end -- ctrl+a / ctrl+e still do that.
keybind = super+arrow_left=text:\x1b[1;3D
keybind = super+arrow_right=text:\x1b[1;3C
